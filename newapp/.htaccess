# ITOps — Root .htaccess (works at domain root OR in a subfolder like /itops/)
Options -Indexes
DirectoryIndex index.html index.php

# --- Never cache the app shell / HTML entry files ---
# Without this, cPanel/LiteSpeed or a CDN can keep serving an OLD index.html
# after you upload an update, making fixes look like they "didn't take."
<IfModule mod_headers.c>
  # BT147: the installed app's helper is always checked for a newer copy
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
<IfModule LiteSpeed>
  # Disable LiteSpeed cache for the WHOLE app, including the /itops/ directory
  # request (which has no .html in the URL). This is what stops old builds from
  # being served after an update — no Cache Manager access needed.
  RewriteEngine On
  CacheLookup public off
  RewriteRule .* - [E=Cache-Control:no-cache,E=cache-control:no-cache]
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Pass the Authorization header through to PHP ---
# cPanel/LiteSpeed/FastCGI often strip "Authorization"; without this the API
# never sees the login token and returns "Authentication required".
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Force HTTPS (uncomment in production once your certificate is active)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API: send non-file /api/... requests to the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/ api/index.php [QSA,L]

# Serve real files and directories as-is (assets, uploads, installer)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback: client-side routes load the app shell
RewriteRule ^ index.html [L]
</IfModule>

# Some FastCGI setups need this form instead/also (harmless if unused)
<IfModule mod_setenvif.c>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    # BT29: framing is controlled by "frame-ancestors" in the Content-Security-Policy below (this app itself and
    # Microsoft Teams / Microsoft 365 only). X-Frame-Options cannot express that list, so it is not sent.
    Header always unset X-Frame-Options
    Header unset X-Frame-Options
    # X-XSS-Protection is obsolete (review CORE-28); the Content-Security-Policy below does that job.
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Content-Security-Policy. BT90 (code audit M-40): scripts come from this site only — the app is compiled before it is
    # shipped (no compiler in the browser, so no 'unsafe-eval'), the libraries are in vendor/ (no script from another
    # site), and no page has inline scripts or inline handlers (no 'unsafe-inline' for scripts). Styles and fonts may still
    # come from Google Fonts; inline styles stay allowed (the app sets styles on its elements).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://res.cdn.office.net; object-src 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com https://*.cloud.microsoft https://*.microsoft365.com https://*.office.com https://outlook.office.com https://outlook.office365.com; upgrade-insecure-requests"
    # Force HTTPS for 6 months (the session cookie is already Secure-only).
    Header always set Strict-Transport-Security "max-age=15768000"
    # Disable browser features the app does not use.
    Header always set Permissions-Policy "geolocation=(), camera=(self), microphone=(self), payment=(), usb=()"
    # Public forms may be embedded in a website or intranet page ("Copy embed", review UI2-9): form.html alone may be framed
    # by any https site. It shows only the public form; signing in and the app itself stay unframeable elsewhere.
    <Files "form.html">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://res.cdn.office.net; object-src 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https:; upgrade-insecure-requests"
    </Files>
    # Always load the app HTML fresh so updates aren't masked by browser cache
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Deny access to sensitive files
<FilesMatch "(\.(sql|md|env|log|sh)|^CHANGELOG\.txt)$">
    Require all denied
</FilesMatch>
<FilesMatch "^config(\.sample)?\.php$">
    Require all denied
</FilesMatch>

# The integrator guide is public by design (linked from Administration > Integrations).
# It is .md, so the rule above would otherwise deny it — grant this one file explicitly.
<Files "API-INTEGRATION-GUIDE.md">
    Require all granted
</Files>
