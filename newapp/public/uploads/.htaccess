# ITOps — uploads hardening: never execute or render active content from uploads (BT14: case-insensitive, more types)
Options -ExecCGI -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
# Nothing in uploads is ever a script, whatever the handler configuration of the host
<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .phps .cgi .pl .py .sh .shtml
  RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .phps
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php\d*|phtml|pht|phar|phps|cgi|pl|py|sh|shtml|svg|svgz|html?|xhtml|xht|xml|xsl|js|mjs|htaccess)$">
  Require all denied
</FilesMatch>
# Text / data / Office files are always downloaded, never displayed in the browser
<FilesMatch "(?i)\.(json|txt|log|csv|doc|docx|xls|xlsx|ppt|pptx|rtf|md)$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
  </IfModule>
</FilesMatch>
# BT87 (code audit M-18): files sent with the public forms and ticket attachments are only reached through the app,
# by people signed in (the ticket's Attachments) — never by their address. Review CORE-13: so are contract, vendor, asset and
# invoice attachments (documents/) and standards evidence (standards/), downloaded through the API only.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(forms|tickets|documents|standards)/ - [F,NC]
</IfModule>
<IfModule !mod_rewrite.c>
  <IfModule mod_alias.c>
    RedirectMatch 403 (?i)/uploads/(forms|tickets|documents|standards)/
  </IfModule>
</IfModule>
